{
 "groups": [
  {
   "id": "basic",
   "title": "基礎與進階運算",
   "items": [
    {
     "name": "sqrt(x)",
     "alias": [
      "√x",
      "√(…)"
     ],
     "desc": "平方根 √x",
     "ex": "sqrt(16)",
     "out": "4"
    },
    {
     "name": "isqrt(n)",
     "desc": "整數平方根 ⌊√n⌋（僅限非負整數）",
     "ex": "isqrt(17)",
     "out": "4"
    },
    {
     "name": "cbrt(x)",
     "alias": [
      "∛x"
     ],
     "desc": "立方根 ∛x",
     "ex": "cbrt(27)",
     "out": "3"
    },
    {
     "name": "fourthroot(x)",
     "alias": [
      "∜x"
     ],
     "desc": "四次方根 x^(1/4)",
     "ex": "fourthroot(81)",
     "out": "3"
    },
    {
     "name": "root(x, n)",
     "desc": "任意次方根 x^(1/n)；n 為奇數時支援負數輸入",
     "ex": "root(-32,5)",
     "out": "-2"
    },
    {
     "name": "pow(x, y)",
     "alias": [
      "x^y",
      "x**y"
     ],
     "desc": "冪次 x^y",
     "ex": "pow(2,10)",
     "out": "1024"
    },
    {
     "name": "exp(x)",
     "desc": "自然指數 eˣ",
     "ex": "exp(0)",
     "out": "1"
    },
    {
     "name": "abs(x)",
     "alias": [
      "Abs(x)",
      "|x|"
     ],
     "desc": "絕對值",
     "ex": "abs(-5)",
     "out": "5"
    },
    {
     "name": "sign(x)",
     "alias": [
      "sgn(x)"
     ],
     "desc": "正負號：x>0 為 1、x=0 為 0、x<0 為 -1",
     "ex": "sign(-7)",
     "out": "-1"
    },
    {
     "name": "hypot(a, b)",
     "desc": "斜邊長 √(a²+b²)",
     "ex": "hypot(3,4)",
     "out": "5"
    },
    {
     "name": "dist(p, q)",
     "desc": "兩點間的歐幾里得距離 √(Σ(pᵢ−qᵢ)²)",
     "ex": "dist([0,0],[3,4])",
     "out": "5"
    },
    {
     "name": "mod(a, b)",
     "alias": [
      "a mod b",
      "a%b"
     ],
     "desc": "取餘數",
     "ex": "mod(10,3)",
     "out": "1"
    },
    {
     "name": "random(a, b)",
     "desc": "在 a～b 之間隨機取一個數（精確有理數，支援小數如 random(0.5,2.5)）",
     "ex": "random(1,6)",
     "out": "1～6 之間的隨機整數"
    }
   ]
  },
  {
   "id": "log",
   "title": "對數函數",
   "note": "注意：log(x) 只給一個引數時，底數是 10（與 log10、lg 相同）；要自然對數請用 ln(x)。",
   "items": [
    {
     "name": "ln(x)",
     "desc": "自然對數 ln x（底為 e）",
     "ex": "ln(e)",
     "out": "1"
    },
    {
     "name": "log10(x)",
     "alias": [
      "lg(x)",
      "log(x)"
     ],
     "desc": "以 10 為底 log₁₀x",
     "ex": "log10(1000)",
     "out": "3"
    },
    {
     "name": "log2(x)",
     "alias": [
      "lb(x)"
     ],
     "desc": "以 2 為底 log₂x",
     "ex": "log2(8)",
     "out": "3"
    },
    {
     "name": "log(x, y)",
     "desc": "以 x 為底、對 y 取對數：log_x(y) = ln y ÷ ln x",
     "ex": "log(2,8)",
     "out": "3"
    },
    {
     "name": "logN(y)",
     "alias": [
      "log5(25)"
     ],
     "desc": "底數直接寫在函數名稱後面（N 為 2 與 10 以外的整數）",
     "ex": "log5(25)",
     "out": "2"
    }
   ]
  },
  {
   "id": "trig",
   "title": "三角函數",
   "note": "輸入角度會依「角度單位」換算（弧度／角度）；點選範例時會自動切到合適的單位。",
   "items": [
    {
     "name": "sin(x)",
     "desc": "正弦",
     "ex": "sin(30)",
     "angle": "degree",
     "out": "1/2"
    },
    {
     "name": "cos(x)",
     "desc": "餘弦",
     "ex": "cos(60)",
     "angle": "degree",
     "out": "1/2"
    },
    {
     "name": "tan(x)",
     "alias": [
      "tg(x)"
     ],
     "desc": "正切 sin x ÷ cos x",
     "ex": "tan(45)",
     "angle": "degree",
     "out": "1"
    },
    {
     "name": "csc(x)",
     "alias": [
      "cosec(x)"
     ],
     "desc": "餘割 1 ÷ sin x",
     "ex": "csc(30)",
     "angle": "degree",
     "out": "2"
    },
    {
     "name": "sec(x)",
     "desc": "正割 1 ÷ cos x",
     "ex": "sec(60)",
     "angle": "degree",
     "out": "2"
    },
    {
     "name": "cot(x)",
     "alias": [
      "ctg(x)"
     ],
     "desc": "餘切 cos x ÷ sin x",
     "ex": "cot(45)",
     "angle": "degree",
     "out": "1"
    }
   ]
  },
  {
   "id": "atrig",
   "title": "反三角函數",
   "note": "輸出的角度會依「角度單位」換算。",
   "items": [
    {
     "name": "asin(x)",
     "alias": [
      "arcsin(x)"
     ],
     "desc": "反正弦",
     "ex": "asin(1/2)",
     "angle": "degree",
     "out": "30"
    },
    {
     "name": "acos(x)",
     "alias": [
      "arccos(x)"
     ],
     "desc": "反餘弦",
     "ex": "acos(0)",
     "angle": "degree",
     "out": "90"
    },
    {
     "name": "atan(x)",
     "alias": [
      "arctan(x)"
     ],
     "desc": "反正切",
     "ex": "atan(1)",
     "angle": "degree",
     "out": "45"
    },
    {
     "name": "acsc(x)",
     "alias": [
      "arccsc(x)"
     ],
     "desc": "反餘割",
     "ex": "acsc(2)",
     "angle": "degree",
     "out": "30"
    },
    {
     "name": "asec(x)",
     "alias": [
      "arcsec(x)"
     ],
     "desc": "反正割",
     "ex": "asec(2)",
     "angle": "degree",
     "out": "60"
    },
    {
     "name": "acot(x)",
     "alias": [
      "arccot(x)"
     ],
     "desc": "反餘切",
     "ex": "acot(1)",
     "angle": "degree",
     "out": "45"
    }
   ]
  },
  {
   "id": "hav",
   "title": "半正矢族與古典三角函數",
   "items": [
    {
     "name": "versin(x)",
     "desc": "正矢 1 − cos x",
     "ex": "versin(60)",
     "angle": "degree",
     "out": "1/2"
    },
    {
     "name": "vercosin(x)",
     "desc": "餘正矢 1 + cos x",
     "ex": "vercosin(60)",
     "angle": "degree",
     "out": "3/2"
    },
    {
     "name": "coversin(x)",
     "desc": "餘矢 1 − sin x",
     "ex": "coversin(30)",
     "angle": "degree",
     "out": "1/2"
    },
    {
     "name": "covercosin(x)",
     "desc": "1 + sin x",
     "ex": "covercosin(30)",
     "angle": "degree",
     "out": "3/2"
    },
    {
     "name": "haversin(x)",
     "desc": "半正矢 (1 − cos x) ÷ 2 = sin²(x/2)",
     "ex": "haversin(60)",
     "angle": "degree",
     "out": "1/4"
    },
    {
     "name": "havercosin(x)",
     "desc": "(1 + cos x) ÷ 2",
     "ex": "havercosin(60)",
     "angle": "degree",
     "out": "3/4"
    },
    {
     "name": "hacoversin(x)",
     "desc": "(1 − sin x) ÷ 2",
     "ex": "hacoversin(30)",
     "angle": "degree",
     "out": "1/4"
    },
    {
     "name": "hacovercosin(x)",
     "desc": "(1 + sin x) ÷ 2",
     "ex": "hacovercosin(30)",
     "angle": "degree",
     "out": "3/4"
    },
    {
     "name": "exsec(x)",
     "desc": "外正割 sec x − 1",
     "ex": "exsec(60)",
     "angle": "degree",
     "out": "1"
    },
    {
     "name": "excsc(x)",
     "desc": "外餘割 csc x − 1",
     "ex": "excsc(30)",
     "angle": "degree",
     "out": "1"
    },
    {
     "name": "crd(x)",
     "desc": "弦長 2·sin(x/2)（單位圓上圓心角 x 所對的弦長）",
     "ex": "crd(60)",
     "angle": "degree",
     "out": "1"
    }
   ]
  },
  {
   "id": "hyper",
   "title": "雙曲函數",
   "note": "與角度單位無關，恆以弧度概念運算。",
   "items": [
    {
     "name": "sinh(x)",
     "desc": "雙曲正弦 (eˣ − e⁻ˣ) ÷ 2",
     "ex": "sinh(0)",
     "out": "0"
    },
    {
     "name": "cosh(x)",
     "desc": "雙曲餘弦 (eˣ + e⁻ˣ) ÷ 2",
     "ex": "cosh(0)",
     "out": "1"
    },
    {
     "name": "tanh(x)",
     "desc": "雙曲正切 sinh x ÷ cosh x",
     "ex": "tanh(0)",
     "out": "0"
    },
    {
     "name": "coth(x)",
     "desc": "雙曲餘切 cosh x ÷ sinh x",
     "ex": "coth(oo)",
     "out": "1"
    },
    {
     "name": "sech(x)",
     "desc": "雙曲正割 1 ÷ cosh x",
     "ex": "sech(0)",
     "out": "1"
    },
    {
     "name": "csch(x)",
     "desc": "雙曲餘割 1 ÷ sinh x",
     "ex": "csch(oo)",
     "out": "0"
    },
    {
     "name": "asinh(x)",
     "alias": [
      "arsinh(x)",
      "arcsinh(x)"
     ],
     "desc": "反雙曲正弦 ln(x + √(x²+1))",
     "ex": "asinh(0)",
     "out": "0"
    },
    {
     "name": "acosh(x)",
     "alias": [
      "arcosh(x)",
      "arccosh(x)"
     ],
     "desc": "反雙曲餘弦 ln(x + √(x²−1))，x ≥ 1",
     "ex": "acosh(1)",
     "out": "0"
    },
    {
     "name": "atanh(x)",
     "alias": [
      "artanh(x)",
      "arctanh(x)"
     ],
     "desc": "反雙曲正切 ½·ln((1+x) ÷ (1−x))，|x| < 1",
     "ex": "atanh(0)",
     "out": "0"
    }
   ]
  },
  {
   "id": "angle",
   "title": "角度與弧度轉換",
   "items": [
    {
     "name": "degrees(x)",
     "alias": [
      "deg(x)"
     ],
     "desc": "弧度轉角度：x × 180 ÷ π",
     "ex": "degrees(pi)",
     "out": "180"
    },
    {
     "name": "radians(x)",
     "desc": "角度轉弧度：x × π ÷ 180（注意 rad(x) 是質因數之積，不是這個）",
     "ex": "radians(180)",
     "out": "π"
    }
   ]
  },
  {
   "id": "round",
   "title": "取整與數值處理",
   "items": [
    {
     "name": "floor(x)",
     "alias": [
      "⌊x⌋"
     ],
     "desc": "向下取整",
     "ex": "floor(-2.5)",
     "out": "-3"
    },
    {
     "name": "ceil(x)",
     "alias": [
      "ceiling(x)",
      "⌈x⌉"
     ],
     "desc": "向上取整",
     "ex": "ceil(2.1)",
     "out": "3"
    },
    {
     "name": "trunc(x)",
     "desc": "截斷小數（往 0 取整）",
     "ex": "trunc(-2.9)",
     "out": "-2"
    },
    {
     "name": "round(x)",
     "desc": "四捨五入至整數（恰為 .5 時進到偶數：round(2.5)=2、round(3.5)=4）",
     "ex": "round(3.7)",
     "out": "4"
    },
    {
     "name": "round(x, n)",
     "desc": "四捨五入至小數點後 n 位",
     "ex": "round(2.567,2)",
     "out": "2.57"
    }
   ]
  },
  {
   "id": "comb",
   "title": "階乘與組合數學",
   "items": [
    {
     "name": "factorial(x)",
     "alias": [
      "x!"
     ],
     "desc": "n! = n × (n−1) × … × 1，0! = 1（引數上限 500）",
     "ex": "5!",
     "out": "120"
    },
    {
     "name": "double_factorial(x)",
     "alias": [
      "factorial2(x)",
      "x!!"
     ],
     "desc": "雙階乘 n × (n−2) × (n−4) × …，0!! = 1",
     "ex": "7!!",
     "out": "105"
    },
    {
     "name": "multifactorial(x, k)",
     "alias": [
      "x!^(k)",
      "x!!!"
     ],
     "desc": "k 重階乘：n × (n−k) × (n−2k) × … 直到 ≥ 1",
     "ex": "7!^(3)",
     "out": "28"
    },
    {
     "name": "subfactorial(x)",
     "alias": [
      "!x"
     ],
     "desc": "子階乘（錯排數）：n 個元素完全錯位的排列數",
     "ex": "!4",
     "out": "9"
    },
    {
     "name": "H(x)",
     "alias": [
      "hyperfactorial(x)"
     ],
     "desc": "超階乘 1¹ × 2² × 3³ × … × nⁿ",
     "ex": "H(3)",
     "out": "108"
    },
    {
     "name": "sf(x)",
     "alias": [
      "superfactorial(x)"
     ],
     "desc": "超階乘（superfactorial）1! × 2! × … × n!",
     "ex": "sf(4)",
     "out": "288"
    },
    {
     "name": "primorial(x)",
     "alias": [
      "x#"
     ],
     "desc": "質數階乘：不超過 n 的所有質數之積",
     "ex": "7#",
     "out": "210"
    },
    {
     "name": "comb(n, k)",
     "alias": [
      "C(n, k)"
     ],
     "desc": "組合數 C(n,k) = n! ÷ (k!(n−k)!)",
     "ex": "C(5,2)",
     "out": "10"
    },
    {
     "name": "perm(n, k)",
     "alias": [
      "P(n, k)"
     ],
     "desc": "排列數 P(n,k) = n! ÷ (n−k)!",
     "ex": "P(5,2)",
     "out": "20"
    },
    {
     "name": "H(n, k)",
     "alias": [
      "h(n, k)"
     ],
     "desc": "重複組合 H(n,k) = C(n+k−1, k)（H 依引數個數自動判斷）",
     "ex": "H(3,2)",
     "out": "6"
    }
   ]
  },
  {
